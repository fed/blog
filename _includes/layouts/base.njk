<!--! Deployed {{ build.date }} (commit hash {{ build.commit }}) -->
<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content="{{ description or metadata.description }}">
		<meta name="generator" content="{{ eleventy.generator }}">
		<link rel="icon" type="image/x-icon" href="/assets/favicon.ico">

		<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ metadata.title }}">
		<link rel="canonical" href="{{ metadata.url }}{{ page.url }}">
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ description or metadata.description }}">
		<meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
		<meta property="og:type" content="{{ 'article' if 'posts' in (tags or []) else 'website' }}">
		<meta name="twitter:card" content="summary">

		<title>
			{% if title %}{{ title }} - {% endif %}{{ metadata.title }}
		</title>

		<script>
			{% include "scripts/theme-init.js" %}
		</script>

		{# Capture the CSS content as a Nunjucks variable and feed it through to the cssmin filter to minify it #}
		{% set css %}
		{% include "node_modules/@csstools/normalize.css/normalize.css" %}
		{% include "styles/tokens.css" %}
		{% include "styles/global.css" %}
		{% include "styles/common.css" %}
		{% include "styles/layout.css" %}
		{% include "styles/search.css" %}
		{% endset %}
		<style>
			{{css | cssmin | safe}}
		</style>
	</head>
	<body>

		<a href="#main" class="layout-skip-link">
        	Skip to main content
      	</a>

		<header class="layout-header">
			<nav class="layout-header__nav" aria-label="Site">
				<a href="/" class="layout-header__logo common-focus-ring">fk</a>

				<details class="layout-header__menu" open>
					<summary class="layout-header__menu-toggle common-focus-ring" aria-label="Menu">
						<span class="layout-header__menu-toggle-icon layout-header__menu-toggle-icon--closed" aria-hidden="true">
							{% include "assets/hamburger-menu.svg" %}
						</span>
						<span class="layout-header__menu-toggle-icon layout-header__menu-toggle-icon--open" aria-hidden="true">
							{% include "assets/close-menu.svg" %}
						</span>
					</summary>

					<ul class="layout-header__nav-list">
						{%- for entry in collections.all | eleventyNavigation %}
							<li class="layout-header__nav-item">
								<a href="{{entry.url}}"
								   class="layout-header__nav-link common-focus-ring"
								   {% if entry.url == page.url %}aria-current="page"{% endif %}
								   {% if entry.url.startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}>
									{{ entry.key }}{% if entry.url.startsWith('http') %}<span class="visually-hidden"> (external link)</span>{% endif %}
								</a>
							</li>
						{%- endfor %}
					</ul>
				</details>

				<div class="layout-header__actions">
					<a href="https://github.com/fed" class="layout-header__icon-button common-focus-ring" aria-label="GitHub (external link)" target="_blank" rel="noopener noreferrer">
						<span aria-hidden="true">
							{% include "assets/github.svg" %}
						</span>
					</a>

					<button id="search-button" class="layout-header__icon-button common-focus-ring" type="button" aria-label="Search" aria-haspopup="dialog">
						<span aria-hidden="true">
							{% include "assets/search.svg" %}
						</span>
					</button>

					<button id="theme-toggle" class="layout-header__icon-button common-focus-ring" role="switch" aria-label="Dark mode" aria-checked="false">
						<span class="layout-header__theme-icon layout-header__theme-icon--dark" aria-hidden="true">
							{% include "assets/dark-theme.svg" %}
						</span>
						<span class="layout-header__theme-icon layout-header__theme-icon--light" aria-hidden="true">
							{% include "assets/light-theme.svg" %}
						</span>
					</button>
				</div>

				<script>
					{% include "scripts/nav-menu.js" %}
				</script>
			</nav>
		</header>

		<main class="layout-content" id="main">
			{{ content | safe }}
		</main>

		<pagefind-modal></pagefind-modal>

		<script>
			{% include "scripts/theme-toggle.js" %}
		</script>
		<script>
			{% include "scripts/search-button.js" %}
		</script>
	</body>
</html>
