---
title: Blog posts
eleventyNavigation:
  key: Blog
  order: 2
excludeFromSearch: true
---

{% css %}
{% include "styles/archive.css" %}
{% endcss %}

<p>Fresh content sorted by date, so you'll always see what's new at the top. Browse by categories/tags to explore topics you care about. You can also subscribe to the Atom feed for automatic updates.</p>

<div class="archive">
	{# Hidden until the script below runs, since the filters do nothing without JS #}
	<div class="archive__filters" role="group" aria-label="Filter by tag" hidden>
		<button type="button" class="archive__filter common-focus-ring" data-tag="">All ({{ collections.posts | length }})</button>
		{%- for tag in collections.posts | usedTags %}
			<button type="button" class="archive__filter common-focus-ring" data-tag="{{ tag.id }}">{{ tag.title }} ({{ tag.count }})</button>
		{%- endfor %}
	</div>

	<ul class="archive__list">
		{%- for post in collections.posts | reverse %}
			<li class="archive__list-item" data-tags="{{ post.data.tags | join(' ') }}">
				<a href="{{ post.url }}">{{ post.data.title }}</a>
				{% if post.data.format == "field-note" %}
					<span class="archive__icon" role="img" aria-label="Field note">
						{% include "assets/notepad.svg" %}
					</span>
				{% endif %}
				{% if post.data.draft %}
					<span class="archive__icon" role="img" aria-label="Draft">
						{% include "assets/draft.svg" %}
					</span>
				{% endif %}
				<span class="archive__date">(<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate({ day: "2-digit", month: "short", year: "numeric" }) }}</time>)</span>
			</li>
		{%- endfor %}
	</ul>
</div>

<script>
	{% include "scripts/archive-filters.js" %}
</script>
